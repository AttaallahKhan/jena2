# Jena Autonomous Agent Environment Variables
# Copy to ~/.jena/.env or export in ~/.bashrc / ~/.zshrc

# Default Provider (gemini | groq | openai)
JENA_PROVIDER=gemini

# Google Gemini API Key (Google AI Studio - Free tier)
# https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Groq API Key (Fast Inference - Free tier)
# https://console.groq.com/
GROQ_API_KEY=your_groq_api_key_here

# OpenAI API Key
# https://platform.openai.com/
OPENAI_API_KEY=your_openai_api_key_here

# Optional Model Override
# JENA_MODEL=gemini-2.0-flash
